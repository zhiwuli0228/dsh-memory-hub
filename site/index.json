  "plugins": [
    {
      "name": "dsh-memory-hub",
      "title": {
        "en": "Memory Hub",
        "zh": "记忆中枢"
      },
      "description": {
        "en": "Preflight, compact context injection, citations, human-approved knowledge, temporal validity, dedupe/merge, retrospective reflection, write-risk flags, a derived SQLite index, per-workspace scheduled distillation, and a Web panel with in-panel review. Every hub root gets a generated README that explains each folder.",
        "zh": "预检、紧凑上下文注入、引用、人工批准的知识、时效字段、去重合并、回顾式萃取、写入风险标记、派生 SQLite 索引、按工作区定时蒸馏，以及支持面板内人工审核的 Web 面板。每个 Hub 根目录自动生成 README，解释每个文件夹的作用。"
      },
      "icon": "icons/dsh-memory-hub.svg",
      "author": "zhiwuli0228",
      "homepage": "https://github.com/zhiwuli0228/dsh-memory-hub#readme",
